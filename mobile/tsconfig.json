{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@engine": [
        "../src/engine/index.ts"
      ],
      "@engine/*": [
        "../src/engine/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/engine/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
